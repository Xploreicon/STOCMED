# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ADMIN_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_SITE_URL=https://askstocmed.com

# Product email (server-only). Supabase Auth SMTP is configured separately in
# the Supabase dashboard with Resend SMTP credentials.
RESEND_API_KEY=re_your-server-only-key
RESEND_FROM_EMAIL=StocMed <updates@askstocmed.com>
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret
RESEND_ESTIMATED_COST_PER_EMAIL=0

# Transactional SMS (server-only). TERMII_BASE_URL is account/region-specific
# and must be copied from the Termii dashboard.
TERMII_API_KEY=your-server-only-termii-key
TERMII_SENDER_ID=StocMed
TERMII_BASE_URL=https://your-account-base-url
TERMII_WEBHOOK_SECRET=your-termii-webhook-signing-secret
TERMII_ESTIMATED_COST_PER_SMS=0

# Notification privacy, signed unsubscribe links, and spend safety valves.
NOTIFICATION_HASH_PEPPER=generate-a-long-random-secret
NOTIFICATION_SIGNING_SECRET=generate-a-different-long-random-secret
GLOBAL_DAILY_SMS_CAP=500
GLOBAL_DAILY_EMAIL_CAP=2000

# Staffed pharmacist response flows are disabled for the pilot by default.
# Emergency, restricted-drug, and crisis redirects remain enabled regardless.
STAFFED_SAFETY_FLOWS_ENABLED=false
SYMPTOM_INTAKE_ENABLED=false
RX_RESERVATIONS_ENABLED=false

# Required by Vercel Cron when invoking expiry, notification, and private-Rx routes.
CRON_SECRET=generate-a-long-random-secret

# Direct Database Connection String
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Anthropic Claude Integration (AI Assistant & Regulatory Gating)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_TRIAGE_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_ASSISTANT_MODEL=claude-3-5-haiku-20241022
# Fail-closed Prompt 5 release gate. Set true only after the public privacy
# policy accurately discloses the live Anthropic inventory-processing terms.
AI_PROCESSING_PRIVACY_DISCLOSURE_LIVE=false

# StocMed Regulatory Guard Settings
# Enforces direct-to-pharmacy payment routing (Software of Record model).
# MUST BE SET TO false IN PRODUCTION.
NEXT_PUBLIC_STOCMED_MEDIATED_COLLECTION=false
STOCMED_MEDIATED_COLLECTION=false

# Sentry Monitoring & Observability (Server & Client)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://your-sentry-dsn-key@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
